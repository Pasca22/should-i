# Copy to .env.local and fill in. .env.local is gitignored.

# Postgres from docker-compose.yml (host port 5440)
DATABASE_URL=

# TypeSafe (Jev). Server-side only; never exposed to the browser.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Better Auth (login). Generate the secret with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Closed beta: these Google accounts are admins (unlimited checks, /admin). Comma-separated.
ADMIN_EMAILS=
